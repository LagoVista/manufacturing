<Window x:Class="LagoVista.PickAndPlace.App.Controls.PickAndPlace.PhotonFeederControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Feeder Control Panel" Width="1120" Height="760" MinWidth="880" MinHeight="610"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#161C25" Foreground="#EDF2F8" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#245579"/>
            <Setter Property="Foreground" Value="#EDF8FF"/>
            <Setter Property="BorderBrush" Value="#527F9D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A7D7F9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Entry" TargetType="TextBox">
            <Setter Property="Background" Value="#101721"/>
            <Setter Property="Foreground" Value="#EDF2F8"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#54708B"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#222D3C" CornerRadius="9" Padding="16" Margin="0,0,0,12"
                Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock Text="MACHINE UTILITIES / AUTOMATIC FEEDERS" Foreground="#8CC9F6" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Auto Feeder Control Panel" FontSize="25" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Text="Photon / RS485  ·  Manual commissioning  ·  No inventory changes" Foreground="#B4C5D9" FontSize="13"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#1E2B39" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding ManualTestStatus}" Foreground="#8CC9F6" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status, FallbackValue=Idle}" Foreground="#EDF2F8" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#1E2B39" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="DISCOVERY" Foreground="#8CC9F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="Slots to scan" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Style="{StaticResource Entry}" Width="66" Height="36" Margin="0,0,8,8"
                                     Text="{Binding SlotsToSearch, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            <Button Content="Discover" Style="{StaticResource PanelButton}" Command="{Binding DiscoverFeedersCommand}" Background="#277EC4"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DiscoveredFeeders.Count, StringFormat='Found: {0} feeders'}" Foreground="#B4C5D9"/>
                        <ProgressBar Height="7" Margin="0,8,0,0" Maximum="{Binding SlotsToSearch}" Value="{Binding SlotSearchIndex}"
                                     Visibility="{Binding IsBusBusy, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#1E2B39" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding DiscoveredFeeders}" SelectedItem="{Binding SelectedPhotonFeeder, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" RowHeaderWidth="0" FontSize="13" Background="#101721"
                              Foreground="#EDF2F8" RowBackground="#1A2533" AlternatingRowBackground="#222D3C"
                              GridLinesVisibility="None" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#26394D"/>
                                <Setter Property="Foreground" Value="#D7E6F5"/>
                                <Setter Property="Padding" Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#EDF2F8"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#245579"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="52"/>
                            <DataGridTextColumn Header="Physical feeder ID" Binding="{Binding Address}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Row="2" Background="#1E2B39" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SELECTED FEEDER" Foreground="#8CC9F6" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedPhotonFeeder.Slot, StringFormat='Slot {0}', TargetNullValue='No feeder selected'}" FontSize="20" FontWeight="SemiBold" Margin="0,4"/>
                        <TextBlock Text="{Binding SelectedPhotonFeeder.Address}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#B4C5D9"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#1E2B39" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MANUAL FEEDER CONTROLS" Foreground="#8CC9F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                        <CheckBox Content="Enable manual testing — feeder and clearance confirmed" IsChecked="{Binding ManualTestArmed, Mode=TwoWay}"
                                  Foreground="#EDF2F8" FontSize="13" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Identify" Command="{Binding IdentifyCommand}" Style="{StaticResource PanelButton}"/>
                            <Button Content="Initialize" Command="{Binding InitializeCommand}" Style="{StaticResource PanelButton}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Distance (mm)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Style="{StaticResource Entry}" Width="75" Height="36" Margin="0,0,8,8"
                                     Text="{Binding ManualDistanceText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="2" Tag="2" Click="DistancePreset_Click" Style="{StaticResource PanelButton}" MinWidth="42"/>
                            <Button Content="4" Tag="4" Click="DistancePreset_Click" Style="{StaticResource PanelButton}" MinWidth="42"/>
                            <Button Content="8" Tag="8" Click="DistancePreset_Click" Style="{StaticResource PanelButton}" MinWidth="42"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Advance" Command="{Binding AdvanceCommand}" Style="{StaticResource PanelButton}" Background="#277EC4"/>
                            <Button Content="Retract" Command="{Binding RetractCommand}" Style="{StaticResource PanelButton}"/>
                            <Button Content="Confirm tape reconciled" Command="{Binding ReconcileCommand}" Style="{StaticResource PanelButton}"/>
                        </WrapPanel>
                        <TextBlock Text="Select a known safe distance. Verify actual tape motion independently." Foreground="#B4C5D9" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#101721" BorderBrush="#35475A" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Copy" Click="Copy_Click" Style="{StaticResource PanelButton}" Height="28" MinWidth="60"/>
                                <Button Content="Clear" Click="Clear_Click" Style="{StaticResource PanelButton}" Height="28" MinWidth="60" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="LIVE COMMUNICATION LOG" Foreground="#8CC9F6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="ConsoleText" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#C6D8EA" Background="#101721"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Style="{StaticResource PanelButton}" Margin="0"/>
            <TextBlock Text="Manual tests are independent of production jobs. Close is unavailable during an active bus operation."
                       Foreground="#B4C5D9" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
