<Window x:Class="LagoVista.PickAndPlace.App.Controls.PickAndPlace.FeederCalibrationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strip Feeder Calibration"
        Width="1000" Height="760" MinWidth="780" MinHeight="550"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#181D26" Foreground="#EAF0F6"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ProgressStateLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A5B2C4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#83C8FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#76E5AD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#FF8F93"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProgressCard" TargetType="Border">
            <Setter Property="Background" Value="#242C38"/>
            <Setter Property="BorderBrush" Value="#3B4553"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="BorderBrush" Value="#4CAAF3"/>
                    <Setter Property="Background" Value="#26374B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="BorderBrush" Value="#355D4E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="#C45257"/>
                    <Setter Property="Background" Value="#39282F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#267CC2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4F9BDC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#232B37" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STRIP FEEDER / MACHINE PROCEDURE"
                               Foreground="#8DBCE7" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding Current.Name}" FontSize="24"
                               FontWeight="SemiBold" Margin="0,5,0,3"/>
                    <TextBlock Text="Locate feeder · Verify barcode · Inspect every installed tape"
                               Foreground="#BBC6D5" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="EXPECTED FEEDER ID" Foreground="#91A5BD"
                               FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Current.FeederId}" FontSize="22"
                               FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="#" Foreground="#A4B2C3"/>
            <TextBlock Grid.Column="1" Text="STEP / EVIDENCE" Foreground="#A4B2C3"/>
            <TextBlock Grid.Column="2" Text="STATUS" Foreground="#A4B2C3"/>
            <TextBlock Grid.Column="3" Text="DURATION" Foreground="#A4B2C3" TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="RETRIES" Foreground="#A4B2C3" TextAlignment="Right"/>
        </Grid>
        <Border Grid.Row="2" Background="#1D242F" CornerRadius="8" Padding="10"
                BorderBrush="#394354" BorderThickness="1" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FeederFlowSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProgressCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number}"
                                               Foreground="#8EA5C3" FontSize="16" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                   Foreground="#BBC7D4" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}"
                                               Style="{StaticResource ProgressStateLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                               Foreground="#CFDAE8" TextAlignment="Right"
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding RetryCount}"
                                               Foreground="#CFDAE8" TextAlignment="Right"
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FeederFlowStatus}" TextWrapping="Wrap"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="The procedure stops on an unsafe move, missing vision evidence, barcode mismatch or failed save. Emergency stop remains a separate machine control."
                           Foreground="#93A7BE" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Run Again" Click="RunAgain_Click"
                    >
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeederFlowFinished}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="Close" Click="Close_Click"
                    Style="{StaticResource DialogButton}"
                    IsEnabled="{Binding FeederFlowFinished}"/>
        </Grid>
    </Grid>
</Window>
