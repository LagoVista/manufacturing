<Window x:Class="LagoVista.PickAndPlace.App.Controls.PickAndPlace.AutoFeederCalibrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Auto Feeder Calibration" Width="980" Height="700" MinWidth="760" MinHeight="540"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="#181D26" Foreground="White" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="MinWidth" Value="120"/>
   <Setter Property="Height" Value="40"/>
   <Setter Property="Padding" Value="14,5"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#267CC2"/>
   <Setter Property="BorderBrush" Value="#4F9BDC"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="WhenIdle" TargetType="FrameworkElement">
   <Setter Property="IsEnabled" Value="True"/>
   <Style.Triggers><DataTrigger Binding="{Binding PlacementBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#232B37" CornerRadius="8" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="AUTOMATIC FEEDERS / MACHINE CALIBRATION" Foreground="#8DBCE7" FontSize="12" FontWeight="Bold"/>
    <TextBlock Text="Auto Feeder Placement Calibration" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,4"/>
    <TextBlock Text="Select one installed feeder. Verify its physical identity, locate the fiducial, then save the measured offset." Foreground="White" FontSize="16" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Background="#242C38" CornerRadius="8" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="FEEDER TO CALIBRATE" Foreground="#8DBCE7" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Feeders}" SelectedItem="{Binding Current, Mode=TwoWay}" Style="{StaticResource WhenIdle}" FontSize="16" MinHeight="34">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Slot, StringFormat='Slot {0}'}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Margin="14,0,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding Current.FeederId, StringFormat='Expected Photon ID: {0}'}" Foreground="White" FontSize="16" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <TextBlock Text="{Binding Current.FiducialOffset, StringFormat='Saved fiducial offset: {0}'}" Foreground="White" FontSize="16" TextWrapping="Wrap"/>
    <CheckBox Content="I confirm the selected feeder and safe machine clearance" IsChecked="{Binding ConfiguredTestArmed, Mode=TwoWay}" Style="{StaticResource WhenIdle}" Foreground="White" FontSize="16" Margin="0,12,0,0"/>
    <TextBlock Text="Machine must be homed, origin calibrated, in Manual mode, with settings unlocked and vacuum off." Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="#101721" BorderBrush="#35475A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="CALIBRATION PROGRESS" Foreground="#8DBCE7" FontSize="12" FontWeight="Bold"/>
    <TextBlock Grid.Row="1" Text="{Binding PlacementStatus}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding PlacementMessages}" Background="#101721" Foreground="White" BorderThickness="0" FontSize="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="White" Margin="0,4"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3">
   <WrapPanel>
    <Button Content="Run Calibration" Command="{Binding SetFeederFiducialLocationCommand}" Style="{StaticResource ActionButton}"/>
    <Button Content="Save Placement" Command="{Binding SavePlacementCommand}" Style="{StaticResource ActionButton}"/>
    <Button Content="Go To Fiducial" Command="{Binding GoToFiducialCommand}" Style="{StaticResource ActionButton}"/>
    <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}"/>
   </WrapPanel>
   <TextBlock Text="No tape movement or inventory changes. Closing discards an unsaved measurement; the machine emergency stop remains independent." Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</Window>