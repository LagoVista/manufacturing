<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.CameraExposureCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Camera Exposure Calibration" Width="1160" Height="820"
        MinWidth="850" MinHeight="640" WindowStartupLocation="CenterOwner"
        Background="#161C25" Foreground="#EDF2F8"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#277EC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#519CD6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DataValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#222D3C" CornerRadius="9"
                Padding="15" Margin="0,0,0,12" Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MACHINE CALIBRATION / CAMERA EXPOSURE"
                               Foreground="#8CC9F6" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Exposure Calibration" FontSize="25"
                               FontWeight="SemiBold" Margin="0,3,0,3"/>
                    <TextBlock Foreground="#B4C5D9" FontSize="12">
                        <Run Text="Camera: "/><Run Text="{Binding SelectedMachineCamera.Name, Mode=OneWay}"/>
                        <Run Text="   ·   Algorithm: Dark / white contrast auto-tune"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="CURRENT CAMERA BASELINE" Foreground="#9AACBF"
                               FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SelectedMachineCamera.Exposure, StringFormat='{}{0:F1}'}"
                               FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="Profile: macfiducial (inherits on success)"
                               FontSize="11" Foreground="#AABCD0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cal:CalibrationStepRail Grid.Column="0" Margin="0,0,12,0"
                Steps="{Binding ExposureSteps}"/>

            <Border Grid.Column="1" Background="#101721" BorderBrush="#35475A"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <cal:CalibrationVideoSurface
                        FrameSource="{Binding Machine.PositionImageCaptureService.CaptureImage}"
                        ShowExposureReference="True"
                        Caption="LIVE POSITION CAMERA · blue: sampling region / center"/>
                    <Border Grid.Row="1" Background="#263747" Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dark / white measurements use the annulus on the video"
                                       Foreground="#C2D3E3" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExposureElapsed}"
                                       FontFamily="Consolas" Foreground="#8CC9F6"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Diagnostics stay out of the normal operation view; problems stay visible in Status. -->
        <Expander Grid.Row="2" Header="Diagnostics and exposure settings" IsExpanded="False"
                  Background="#243040" Foreground="#E5EFFA" BorderBrush="#3C5066"
                  BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <Grid Margin="8" MaxHeight="260">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="ACTUAL EXPOSURE MEASUREMENTS" FontSize="11"
                               Foreground="#91BEE0" FontWeight="Bold" Margin="0,0,0,9"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Candidate exposure: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.CandidateExposure, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Dark level: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.DarkLevel, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="White level: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.WhiteLevel, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Contrast: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.Contrast, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.Decision}"
                               Foreground="#97DCBC" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SAMPLE QUALITY / READ-ONLY TARGETS" FontSize="11"
                               Foreground="#91BEE0" FontWeight="Bold" Margin="0,0,0,9"/>
                    <TextBlock Text="Dark preferred: 56–72 · White preferred: 225–248"
                               Foreground="#CFDBE8" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Dark temporal range: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.DarkRange, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="White temporal range: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.WhiteRange, StringFormat='{}{0:F1}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Iteration / frames: " Width="175"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.Iteration}"/>
                        <TextBlock Text=" / " Foreground="#C5D4E4"/>
                        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Machine.PositionImageCaptureService.ExposureTuneProgress.SampleFrames}"/>
                    </StackPanel>
                    <TextBlock Text="Exposure algorithm is fixed; these values are measurements, not tunable Hough/contour controls."
                               TextWrapping="Wrap" FontSize="11" Foreground="#9AACBF"/>
                </StackPanel>
            </Grid>
        </Expander>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ExposureCalibrationStatus}" FontSize="13"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Runs independently; opening the screen does not move the machine."
                           Foreground="#9DB0C5" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Run / Run Again" Click="RunAgain_Click"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding ExposureCalibrationCanRun}"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding ExposureCalibrationCanRun}"/>
        </Grid>
    </Grid>
</Window>
