<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.VacuumCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Supervised Vacuum Calibration · Both Heads"
        Width="1160" Height="830" MinWidth="970" MinHeight="740"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="Window_Closing" Background="#141D27" Foreground="#ECF4FD">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#1F2D3D"/>
            <Setter Property="BorderBrush" Value="#37526A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2678B7"/>
            <Setter Property="BorderBrush" Value="#508BAC"/>
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#713A48"/>
            <Setter Property="BorderBrush" Value="#BA6473"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </Window.Resources>
    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#243345" CornerRadius="8"
                Padding="15" Margin="0,0,0,10"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MACHINE CALIBRATION / SENSOR &amp; ACTUATOR PROOF"
                               FontSize="11" FontWeight="Bold" Foreground="#90CCF6"/>
                    <TextBlock Text="Vacuum Calibration · Both Heads"
                               FontWeight="SemiBold" FontSize="25"
                               Foreground="#F1F8FF" Margin="0,3,0,2"/>
                    <TextBlock Text="Head 1 → Head 2 · idle, unobstructed, sealed, vented"
                               FontSize="12" Foreground="#B8D0E4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="OPERATOR-SUPERVISED"
                               FontWeight="Bold" Foreground="#F0CC8B"
                               FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="Pauses before each Z contact &amp; sealed reading"
                               Foreground="#BFD4E5" FontSize="11" Margin="0,5,0,0"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Physical stop remains independent"
                               Foreground="#95B1C6" FontSize="10" Margin="0,3,0,0"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1B3346" CornerRadius="6"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding StageStatus}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#95D6FF" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding ProcedureStatus}"
                               FontSize="12" Foreground="#A7BED0"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{Binding Status}" FontSize="12"
                           Foreground="#EDF4FA" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <cal:CalibrationStepRail Grid.Column="0" Margin="0,0,12,0"
                                     Steps="{Binding VacuumSteps}"/>

            <Border Grid.Column="1" Background="#152332"
                    BorderBrush="#334F68" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="HARDWARE SAFETY &amp; CONTACT CHECKPOINTS"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#99CBED" Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding OperatorAcknowledged, Mode=TwoWay}"
                                          Foreground="#DDEBF7" Margin="0,0,0,10">
                                    <TextBlock Text="I verified the machine is homed, in Manual, and the test location, fixture and configured PickHeights are safe."
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="#DDEBF7"/>
                                </CheckBox>
                                <Border Background="#25423F" CornerRadius="5"
                                        Padding="10" Margin="0,0,0,6"
                                        Visibility="{Binding NeedsPlateContact, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HeadDescription, StringFormat='SEALED-NOZZLE CHECK · {0}'}"
                                                   Foreground="#A4EDCF" FontWeight="Bold"
                                                   FontSize="12" Margin="0,0,0,5"/>
                                        <TextBlock Text="The nozzle is at the configured PickHeight. Confirm it is lightly obstructed without a collision; the sensor must still independently prove part-present. Abort to retract and vent if unsure."
                                                   Foreground="#E0F1EB" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <CheckBox Content="I visually confirmed contact/obstruction for this head."
                                                  IsChecked="{Binding OperatorConfirmedContact, Mode=TwoWay}"
                                                  IsEnabled="{Binding NeedsPlateContact}"
                                                  Foreground="#E4FFF0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Run Both uses the acknowledged configured PickHeights and verified safe motion. It pauses only to confirm the actual nozzle seal for each head before evaluating part-present sensor readings."
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="#BFCFE0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="VACUUM ACTUATORS · COMMANDED STATE"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="#9CCDF0" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PumpCommands}" TextWrapping="Wrap"
                                           Foreground="#DCE9F2" FontSize="12"/>
                                <TextBlock Text="A commanded ON/OFF state is not sensor proof. Individual pump channels have been tested, but the legacy Marlin solenoid interface is shared/not independently addressable per head; this procedure does not claim independent valve verification."
                                           Foreground="#E6BB82" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="LAST ACCEPTED SENSOR READINGS"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="#9CCDF0" Margin="0,0,0,7"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#253B4D"
                                            CornerRadius="5" Padding="11" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="HEAD 1 · LEFT" Foreground="#A0D1F7"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding LeftObserved}"
                                                       Foreground="#F1F9FF" FontSize="15"
                                                       TextWrapping="Wrap" Margin="0,7,0,5"/>
                                            <TextBlock Text="{Binding LastLeftSampleUtc, StringFormat='Accepted UTC: {0:HH:mm:ss.fff}'}"
                                                       Foreground="#AAC0D0" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#253B4D"
                                            CornerRadius="5" Padding="11" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="HEAD 2 · RIGHT" Foreground="#A0D1F7"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding RightObserved}"
                                                       Foreground="#F1F9FF" FontSize="15"
                                                       TextWrapping="Wrap" Margin="0,7,0,5"/>
                                            <TextBlock Text="{Binding LastRightSampleUtc, StringFormat='Accepted UTC: {0:HH:mm:ss.fff}'}"
                                                       Foreground="#AAC0D0" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Each value is from a fresh six-reading stable window. It remains the last observed value until a new sensor window passes."
                                           FontSize="10" Foreground="#A4BCCD"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="LATEST RAW SAMPLE WINDOW"
                                           FontSize="11" Foreground="#9CCDF0"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding RawReading}" FontFamily="Consolas"
                                           FontSize="12" Foreground="#F0F5FA"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="MEASURED CALIBRATION · HEAD 1"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="#9CCDF0"/>
                                <TextBlock Text="{Binding LeftSummary}" FontFamily="Consolas"
                                           FontSize="12" Foreground="#D6E5F2"
                                           TextWrapping="Wrap" Margin="0,7,0,13"/>
                                <TextBlock Text="MEASURED CALIBRATION · HEAD 2"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="#9CCDF0"/>
                                <TextBlock Text="{Binding RightSummary}" FontFamily="Consolas"
                                           FontSize="12" Foreground="#D6E5F2"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="CALIBRATION SAVE STATUS"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="#9CCDF0"/>
                                <TextBlock Text="{Binding CalibrationSaveStatus}"
                                           FontSize="12" Foreground="#B8E5CF"
                                           TextWrapping="Wrap" Margin="0,7,0,10"/>
                                <Button Content="Apply Verified Calibration to Machine"
                                        Click="ApplyCalibration_Click"
                                        IsEnabled="{Binding CanApplyCalibration}"
                                        HorizontalAlignment="Left" MinWidth="310"
                                        Style="{StaticResource Action}" Margin="0"/>
                                <TextBlock Text="Saving writes the previously reviewed measured thresholds for both heads to the existing machine configuration. No values are saved by Run Both alone."
                                           Foreground="#B2C6D6" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#1E2B3A" CornerRadius="7"
                Padding="10" Margin="0,11,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextAction, StringFormat='Next guided step: {0}'}"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="#B9DAF1" TextWrapping="Wrap"/>
                    <TextBlock Text="This window stays open alongside machine controls for supervised hardware contact."
                               Foreground="#94AEC3" FontSize="10"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding RunAllAction}"
                        Click="RunAll_Click" IsEnabled="{Binding CanRunAll}"
                        Style="{StaticResource Action}" MinWidth="225"/>
                <Button Grid.Column="2" Content="Next Guided Step"
                        Click="Continue_Click" IsEnabled="{Binding CanContinue}"
                        Style="{StaticResource Action}" MinWidth="145"/>
                <Button Grid.Column="3" Content="Abort / Retract"
                        Click="Abort_Click" IsEnabled="{Binding CanAbort}"
                        Style="{StaticResource Danger}" MinWidth="142"/>
                <Button Grid.Column="4" Content="Close" Click="Close_Click"
                        IsEnabled="{Binding CanClose}"
                        Style="{StaticResource Action}" MinWidth="84"/>
            </Grid>
        </Border>
    </Grid>
</Window>