<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.MachineFiducialCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Machine Fiducial Calibration" Width="1160" Height="820"
        MinWidth="850" MinHeight="640" WindowStartupLocation="CenterOwner"
        Background="#161C25" Foreground="#EDF2F8"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="Window_Closing">
    <Window.Resources>
        <cal:FiducialMarkersConverter x:Key="FiducialMarkers"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#277EC4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#519CD6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DataValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#222D3C" CornerRadius="9"
                Padding="15" Margin="0,0,0,12" Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MACHINE CALIBRATION / FIDUCIAL"
                               Foreground="#8CC9F6" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Fiducial Calibration" FontSize="25"
                               FontWeight="SemiBold" Margin="0,3,0,3"/>
                    <TextBlock Foreground="#B4C5D9" FontSize="12">
                        <Run Text="Camera: "/><Run Text="{Binding CameraName, Mode=OneWay}"/>
                        <Run Text="   ·   Algorithm: Hough circles (macfiducial)"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="EFFECTIVE CAMERA SCALE" Foreground="#9AACBF"
                               FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding PixelsPerMillimeter, StringFormat='{}{0:F1} px/mm'}"
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="Profile: macfiducial · Origin applied only after verification"
                               FontSize="11" Foreground="#AABCD0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cal:CalibrationStepRail Grid.Column="0" Margin="0,0,12,0"
                Steps="{Binding Steps}"/>

            <Border Grid.Column="1" Background="#101721" BorderBrush="#35475A"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <cal:CalibrationVideoSurface
                        FrameSource="{Binding Machine.PositionImageCaptureService.CaptureImage}"
                        ShowExposureReference="False"
                        Markers="{Binding CurrentObservation, Converter={StaticResource FiducialMarkers}}"
                        Caption="LIVE POSITION CAMERA · blue target · yellow candidate · green centered"/>
                    <Border Grid.Row="1" Background="#263747" Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hough circle · verified center error in mm · live observation"
                                       Foreground="#C2D3E3" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding Elapsed}"
                                       FontFamily="Consolas" Foreground="#8CC9F6"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Expanded details never cover the dominant camera or hide safety errors. -->
        <Expander Grid.Row="2" Header="Advanced tools: detector tuning, fine jog and diagnostics" IsExpanded="False"
                  Background="#243040" Foreground="#E5EFFA" BorderBrush="#3C5066"
                  BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="290">
                <StackPanel>
                    <Expander Header="Tune Hough circle detector (staged)" IsExpanded="False"
                              Foreground="#EDF2F8" Background="#1B2937"
                              BorderBrush="#40566D" BorderThickness="1" Padding="8"
                              Margin="0,2,0,8">
                        <StackPanel>
                            <TextBlock Text="Change draft values, Apply Preview, then Observe for 8 seconds. Preview is not saved; Save Profile or Revert before automatic calibration."
                                       TextWrapping="Wrap" Foreground="#BBCFE2" FontSize="11"
                                       Margin="0,0,0,9"/>
                            <UniformGrid x:Name="TuningInputs" Columns="3"
                                         IsEnabled="{Binding CanManualAdjust}">
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Hough DP" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.Dp, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Circle separation (mm)" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.MinDistanceMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Edge threshold" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.EdgeThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Accumulator threshold" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.AccumulatorThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Minimum radius (mm)" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.MinimumRadiusMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Maximum radius (mm)" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.MaximumRadiusMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Search radius (mm)" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.SearchRadiusMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Center tolerance (mm)" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.CenterToleranceMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,11,8">
                                    <TextBlock Text="Stable detections" FontSize="11" Foreground="#BFD2E5"/>
                                    <TextBox Text="{Binding Tuning.StabilizationCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="152" HorizontalAlignment="Left"
                                             Background="#182A39" Foreground="#EDF5FD" CaretBrush="#EDF5FD"
                                             BorderBrush="#536C84" Padding="6,4"/>
                                </StackPanel>
                            </UniformGrid>
                            <WrapPanel Margin="0,6,0,6">
                                <Button Content="Apply Preview" Click="ApplyTuning_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}"/>
                                <Button Content="Observe 8 Seconds" Click="ObserveTuning_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}"/>
                                <Button Content="Save Profile" Click="SaveTuning_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}"/>
                                <Button Content="Revert" Click="RevertTuning_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ManualStatus, Mode=OneWay}"
                                       TextWrapping="Wrap" Foreground="#91C8F4" FontSize="11"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Fine position jog (0.1 / 0.5 mm)" IsExpanded="False"
                              Foreground="#EDF2F8" Background="#1B2937"
                              BorderBrush="#40566D" BorderThickness="1" Padding="8"
                              Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Select position-camera navigation before jogging. Connected, homed, Manual mode and idle required. Each click physically moves XY after safe-Z. This never resets the origin."
                                       TextWrapping="Wrap" Foreground="#E2C39B" FontSize="11"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Step size" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="JogStepSelect" SelectedIndex="0" Width="105">
                                    <ComboBoxItem Content="0.1 mm"/>
                                    <ComboBoxItem Content="0.5 mm"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <Button Content="Y +   ↑" Click="JogUp_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="←   X −" Click="JogLeft_Click"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="{Binding CanManualAdjust}" Margin="0,0,5,0"/>
                                    <Button Content="X +   →" Click="JogRight_Click"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="{Binding CanManualAdjust}" Margin="0,0,0,0"/>
                                </StackPanel>
                                <Button Content="Y −   ↓" Click="JogDown_Click"
                                        Style="{StaticResource ActionButton}"
                                        IsEnabled="{Binding CanManualAdjust}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MachinePositionSummary, Mode=OneWay}"
                                       FontFamily="Consolas" Foreground="#C5D8E9"
                                       Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding ManualStatus, Mode=OneWay}"
                                       TextWrapping="Wrap" Foreground="#91C8F4" FontSize="11"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="CURRENT OBSERVATION AND ACTUAL HOUGH SETTINGS"
                               FontSize="11" FontWeight="Bold" Foreground="#91BEE0"
                               Margin="5,12,0,6"/>
                    <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="LATEST LIVE CIRCLE" FontSize="11"
                                   Foreground="#91BEE0" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentObservation.ObservedAtUtc, StringFormat='Observed UTC: {0:HH:mm:ss.fff}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.FrameAtUtc, StringFormat='Frame UTC: {0:HH:mm:ss.fff}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.RadiusMm, StringFormat='Radius: {0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.RadiusPx, StringFormat='Radius: {0:F1} px'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.OffsetXmm, StringFormat='Offset X: {0:+0.00;-0.00;0.00} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.OffsetYmm, StringFormat='Offset Y: {0:+0.00;-0.00;0.00} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.FoundCount, StringFormat='Track samples: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.PositionSpreadMm, StringFormat='Position spread: {0:F3} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.Stabilized, StringFormat='Count stabilized: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.PositionStable, StringFormat='Position stable: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.Centered, StringFormat='Centered: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CurrentObservation.RejectionReason}"
                                   TextWrapping="Wrap" Foreground="#F6B7AC" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap"
                                   Foreground="#DBB0AB" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ACTUAL HOUGH PROFILE / READ ONLY" FontSize="11"
                                   Foreground="#91BEE0" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Camera.PixelsPerMM, StringFormat='Camera baseline scale: {0:F1} px/mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.PixelsPerMM, StringFormat='Profile override scale: {0:F1} px/mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding PixelsPerMillimeter, StringFormat='Effective scale: {0:F1} px/mm'}" Margin="0,0,0,7"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesDP, StringFormat='DP: {0:F2}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesMinDistance, StringFormat='Minimum separation: {0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesParam1, StringFormat='Edge threshold: {0:F1}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesParam2, StringFormat='Accumulator threshold: {0:F1}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesMinRadius, StringFormat='Minimum radius: {0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.HoughCirclesMaxRadius, StringFormat='Maximum radius: {0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.TargetImageRadius, StringFormat='Search radius: {0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.ErrorToleranceMM, StringFormat='Center tolerance: ±{0:F2} mm'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Machine.PositionImageCaptureService.Profile.StabilizationCount, StringFormat='Required detections: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ObservationCount, StringFormat='Detection observations: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding StableObservationCount, StringFormat='Stable observations: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding CenteringMoves, StringFormat='Centering moves: {0}'}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding MachinePositionSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"
                            Padding="10" Background="#1B2734" BorderBrush="#35475A"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="RECENT FRAME / MOTION / VERIFICATION EVENTS (UTC)"
                                       FontSize="11" FontWeight="Bold" Foreground="#91BEE0"
                                       Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding EventLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="#C6D6E6" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="13"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Runs independently · coordinate reset only after verified centering · no staging plate run."
                           Foreground="#9DB0C5" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Run / Run Again" Click="RunAgain_Click"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding CanRun}"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding CanClose}"/>
        </Grid>
    </Grid>
</Window>
