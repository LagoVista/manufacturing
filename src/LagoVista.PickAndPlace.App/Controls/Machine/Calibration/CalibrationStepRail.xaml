<UserControl x:Class="LagoVista.PickAndPlace.App.Controls.Machine.Calibration.CalibrationStepRail"
        x:Name="StepRail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="StepRail_Loaded" Unloaded="StepRail_Unloaded">
    <UserControl.Resources>
        <!-- Shared dark scrollbar: slim rounded thumb, no bright system chrome,
             with normal scroll wheel, drag, page and keyboard interaction. -->
        <Style x:Key="CalibrationScrollbarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="#172330"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False" IsTabStop="False"
                                        BorderThickness="0" Background="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Margin="1,2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Grip" CornerRadius="4"
                                                        Background="#547390"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="#82AED1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="#9AC9EA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False" IsTabStop="False"
                                        BorderThickness="0" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcedureCard" TargetType="Border">
            <Setter Property="Background" Value="#25303D"/>
            <Setter Property="BorderBrush" Value="#39495B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="BorderBrush" Value="#4BB8FF"/>
                    <Setter Property="Background" Value="#233D52"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="BorderBrush" Value="#367F62"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="#D96A71"/>
                    <Setter Property="Background" Value="#3C2930"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProcedureStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8499B0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#8BCDF9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#79DCAF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#FF8D95"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="#1D2633" BorderBrush="#35475A"
            BorderThickness="1" CornerRadius="8" Padding="11">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="PROCEDURE STEPS"
                       FontSize="11" FontWeight="Bold" Foreground="#99B5D0"
                       Margin="4,2,0,12"/>
            <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource CalibrationScrollbarStyle}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="StepItems"
                              ItemsSource="{Binding Steps, ElementName=StepRail}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProcedureCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                   Style="{StaticResource ProcedureStatus}"
                                                   FontSize="11" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" Foreground="#B6C7D8"
                                               FontSize="11" TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Duration}" Foreground="#91A6BC"
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
