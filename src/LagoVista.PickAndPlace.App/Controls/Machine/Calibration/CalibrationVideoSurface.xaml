<UserControl x:Class="LagoVista.PickAndPlace.App.Controls.Machine.Calibration.CalibrationVideoSurface"
        x:Name="VideoSurface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration">
    <Grid Background="#0C121B" ClipToBounds="True">
        <Image Source="{Binding FrameSource, ElementName=VideoSurface}"
               Stretch="Uniform" SnapsToDevicePixels="True"/>
        <local:CalibrationVideoOverlay
            FrameSource="{Binding FrameSource, ElementName=VideoSurface}"
            ShowExposureReference="{Binding ShowExposureReference, ElementName=VideoSurface}"
            Markers="{Binding Markers, ElementName=VideoSurface}"
            IsHitTestVisible="False"/>
        <Border Background="#B5101D2B" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="5">
            <TextBlock Text="{Binding Caption, ElementName=VideoSurface}"
                       Foreground="#D8EBFA" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
