<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.NozzleRunoutCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Optical Nozzle Runout Calibration" Width="1160" Height="830"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#151D27" Foreground="#EBF3FB"
        Closing="Window_Closing">
    <Window.Resources>
        <cal:NozzleRunoutMarkersConverter x:Key="NozzleMarkers"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2677B7"/>
            <Setter Property="BorderBrush" Value="#579AC9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TuningAction" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,9,5"/>
            <Setter Property="Background" Value="#245579"/>
            <Setter Property="BorderBrush" Value="#507C9C"/>
            <Setter Property="Foreground" Value="#E5F5FF"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#162737"/>
            <Setter Property="Foreground" Value="#F1F8FF"/>
            <Setter Property="CaretBrush" Value="#F1F8FF"/>
            <Setter Property="BorderBrush" Value="#496986"/>
            <Setter Property="Width" Value="153"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#233043" Padding="15"
                CornerRadius="8" Margin="0,0,0,10"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MACHINE CALIBRATION / OPTICAL NOZZLE RUNOUT"
                               FontSize="11" FontWeight="Bold" Foreground="#87C6F2"/>
                    <TextBlock Text="Nozzle Runout · Single Head" FontSize="25"
                               FontWeight="SemiBold" Margin="0,3,0,3"/>
                    <TextBlock Text="{Binding ToolHeadName}" Foreground="#C4DAEA" FontSize="13"/>
                    <TextBlock Text="{Binding NozzleName}" Foreground="#92B9D3" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="SUPERVISED PROCEDURE" FontSize="10"
                               Foreground="#9BB3C9" HorizontalAlignment="Right"/>
                    <TextBlock Text="12 angles · 0–330° · 30° increments"
                               FontWeight="SemiBold" FontSize="15"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    <TextBlock Text="Bottom camera · max-Y logical zero"
                               Foreground="#B4CBDB" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1D2C3C" BorderBrush="#3E5974"
                BorderThickness="1" CornerRadius="7"
                Padding="11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Installed head / nozzle" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" Width="310" Height="34"
                          ItemsSource="{Binding AvailableRunoutHeads}"
                          SelectedItem="{Binding SelectedRunoutHead, Mode=TwoWay}"
                          Margin="0,0,14,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HeadIndex, StringFormat='Head {0}  ·  '}" />
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CurrentNozzle.Text, StringFormat='  ·  {0}'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunoutRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunoutPreviewBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Selecting a head never starts motion. Start runs only this selected head."
                               FontSize="11" Foreground="#A7C5DD" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RunoutMachine.WasMachinOriginCalibrated, StringFormat='Current session machine origin verified: {0}'}"
                               FontSize="11" Foreground="#B8C6D6" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cal:CalibrationStepRail Grid.Column="0" Margin="0,0,12,0"
                                     Steps="{Binding RunoutSteps}"/>
            <Border Grid.Column="1" Background="#0E1720" BorderBrush="#39516B"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <cal:CalibrationVideoSurface
                        FrameSource="{Binding RunoutMachine.PartInspectionCaptureService.CaptureImage}"
                        ShowExposureReference="False"
                        Caption="LIVE BOTTOM CAMERA · blue acquisition ROI · amber candidate · green verified">
                        <cal:CalibrationVideoSurface.Markers>
                            <MultiBinding Converter="{StaticResource NozzleMarkers}">
                                <Binding Path="RunoutVideoObservation"/>
                                <Binding Path="RunoutMachine.PartInspectionCaptureService.CaptureImage"/>
                                <Binding Path="RunoutMachine.PartInspectionCaptureService.Profile"/>
                                <Binding Path="RunoutMachine.PartInspectionCaptureService.Camera.EffectivePixelsPerMM"/>
                            </MultiBinding>
                        </cal:CalibrationVideoSurface.Markers>
                    </cal:CalibrationVideoSurface>
                    <Border Grid.Row="1" Background="#243447" Padding="9,7">
                        <StackPanel>
                            <TextBlock Text="{Binding RunoutCameraStatus}"
                                       Foreground="#BFD7EA" FontSize="11"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RunoutSearchSummary}"
                                       Foreground="#86D6B1" FontSize="11"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#1D2C39" Padding="9,7"
                            Margin="0,6,0,0" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding CandidateZero}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#E6F3FE"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RunoutSummary}" FontSize="11"
                                       Foreground="#AFCFE1" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="Measured candidate · no rotational zero reset · no saved placement correction"
                                       FontSize="10" Foreground="#E0BE8C"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Expander Grid.Row="3" Header="Applicable Nozzle vision settings and live measurements"
                  IsExpanded="False" Background="#243141" Foreground="#EBF5FE"
                  BorderBrush="#456078" BorderThickness="1"
                  Padding="10" Margin="0,11,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MaxHeight="272">
                <StackPanel Margin="8">
                    <TextBlock Text="NOZZLE PROFILE · ACTUAL DARK-OPENING DETECTOR"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#8ACAF4" Margin="0,0,0,7"/>
                    <TextBlock Text="Only settings used by nozzle acquisition, optical centering, camera and lighting are shown. The opening diameter and phase are measured at runtime. Hough thresholds and staging-only settings are not used."
                               FontSize="11" Foreground="#C4D7E8" TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <TabControl x:Name="NozzleVisionTabs" IsEnabled="{Binding CanTuneRunoutVision}" Background="#1C2B3B"
                                BorderBrush="#49637A" Foreground="#E6F0FB">
                        <TabItem Header="Acquisition / Center">
                            <StackPanel Margin="12">
                                <TextBlock Text="Search radius previews live when camera capture is active. The dark-opening locator has a 72-pixel minimum search radius at low camera scales. The blue circle always shows the effective acquisition area."
                                           FontSize="11" Foreground="#BECFDF"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel><StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Search radius (mm)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.SearchRadiusMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="0.1–30 mm; 72px effective floor" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Center tolerance (mm)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.CenterToleranceMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Runner caps at 0.10 mm" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Stable detections" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.StabilizationCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="2–60 frames" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel></WrapPanel>
                                <TextBlock Text="{Binding RunoutSearchSummary}"
                                           Foreground="#8BD6B2" FontSize="11"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Camera / Lighting">
                            <StackPanel Margin="12">
                                <TextBlock Text="Optional camera overrides; blank means inherit the camera baseline. Lighting is required for nozzle acquisition and is automatically enabled during the run."
                                           FontSize="11" Foreground="#BED2E3"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel><StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Exposure" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.Exposure, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Blank = baseline" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Brightness" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.Brightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Blank = baseline" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Contrast" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.Contrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Blank = baseline" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Focus" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.Focus, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Blank = baseline" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Pixels / mm" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.PixelsPerMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
<TextBlock Text="Blank = calibrated camera" Foreground="#95ACC1" FontSize="10" TextWrapping="Wrap"/>
</StackPanel></WrapPanel>
                                <TextBlock Text="Nozzle illumination overrides (blank = camera defaults)"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#AFCDE2" Margin="0,5,0,8"/>
                                <WrapPanel><StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Light power (0–255)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.LightPower, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Red (0–255)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.LightRed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Green (0–255)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.LightGreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

</StackPanel>
<StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Blue (0–255)" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.LightBlue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

</StackPanel></WrapPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Display">
                            <StackPanel Margin="12">
                                <WrapPanel>
                                    <CheckBox Content="Show original image"
                                              IsChecked="{Binding RunoutVisionTuning.ShowOriginalImage, Mode=TwoWay}"
                                              Margin="0,0,20,10"/>
                                    <CheckBox Content="Show optical crosshair"
                                              IsChecked="{Binding RunoutVisionTuning.ShowCrossHairs, Mode=TwoWay}"
                                              Margin="0,0,20,10"/>
                                    <CheckBox Content="Show calibration square"
                                              IsChecked="{Binding RunoutVisionTuning.ShowCalibrationSquare, Mode=TwoWay}"
                                              Margin="0,0,20,10"/>
                                </WrapPanel>
                                <WrapPanel><StackPanel Width="166" Margin="0,0,14,10">
<TextBlock Text="Annotation zoom" FontSize="11" Foreground="#C5D6E8"/>
<TextBox Style="{StaticResource InputBox}" Text="{Binding RunoutVisionTuning.ZoomLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

</StackPanel></WrapPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <WrapPanel Margin="0,12,0,8">
                        <Button Content="Apply Preview" Click="ApplyNozzlePreview_Click"
                                IsEnabled="{Binding CanTuneRunoutVision}"
                                Style="{StaticResource TuningAction}"/>
                        <Button Content="Save Profile" Click="SaveNozzleProfile_Click"
                                IsEnabled="{Binding CanTuneRunoutVision}"
                                Style="{StaticResource TuningAction}"/>
                        <Button Content="Revert" Click="RevertNozzleProfile_Click"
                                IsEnabled="{Binding CanTuneRunoutVision}"
                                Style="{StaticResource TuningAction}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding RunoutVisionStatus}"
                               Foreground="#A8D4F3" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Border Background="#1A2A3B" BorderBrush="#3A5671"
                            BorderThickness="1" Padding="10" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="LIVE OPTICAL OBSERVATION"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#8ACAF4" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding CurrentCalibrationAngle, StringFormat='Angle: {0}°'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.RadiusMm, StringFormat='Opening radius: {0:F3} mm'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.OffsetXmm, StringFormat='Optical X: {0:+0.000;-0.000;0.000} mm'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.OffsetYmm, StringFormat='Optical Y: {0:+0.000;-0.000;0.000} mm'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.PositionSpreadMm, StringFormat='Spread: {0:F3} mm'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.FoundCount, StringFormat='Detection count: {0}'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                                <TextBlock Text="{Binding RunoutVideoObservation.FrameAtUtc, StringFormat='Frame UTC: {0:HH:mm:ss.fff}'}"
                                           Foreground="#C4D9EC" Margin="0,0,20,5"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding RunoutVideoObservation.RejectionReason}"
                                       TextWrapping="Wrap" Foreground="#E7B3A6" FontSize="11"/>
                            <TextBlock Text="RECORDED ANGLE MEASUREMENTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#8ACAF4" Margin="0,10,0,5"/>
                            <ItemsControl ItemsSource="{Binding CalibrationUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="#C3D8E8"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                           Foreground="#EAF4FC" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="Opening, choosing a head and camera preview never move the machine. Run requires verified origin and both staging plates."
                           FontSize="10" TextWrapping="Wrap"
                           Foreground="#9EBDD3" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Preview Bottom Camera"
                    Style="{StaticResource ActionButton}"
                    Click="PreviewCamera_Click" IsEnabled="{Binding CanTuneRunoutVision}"/>
            <Button Grid.Column="2" Content="Start Runout / Run Again"
                    Style="{StaticResource ActionButton}"
                    Click="RunAgain_Click" IsEnabled="{Binding CanStartRunout}"/>
            <Button Grid.Column="3" Content="Close" Click="Close_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunoutRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RunoutPreviewBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
