<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.CameraToolPickupCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Camera-to-Tool XY Calibration"
        Width="1160" Height="830" MinWidth="950" MinHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="#161C25" Foreground="#EDF2F8"
        Closing="Window_Closing">
    <Window.Resources>
        <cal:CameraToolSavedPickupMarkersConverter x:Key="SavedPickupMarkers"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#277EC4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F9BD8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PhaseCard" TargetType="Border">
            <Setter Property="Background" Value="#222D3C"/>
            <Setter Property="BorderBrush" Value="#40546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PhaseTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F6FC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#EDF2F8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A9B7C7"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="160"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PhaseButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Tool head &amp; bottom-camera calibration" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Complete both heads in order · radial tolerance 0.200 mm" FontSize="14" Foreground="#B9C6D6"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Stop after safe boundary" Click="StopDiagnostics_Click" IsEnabled="{Binding AutomaticRunActive}" Style="{StaticResource ActionButton}" Margin="8,0"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" IsEnabled="{Binding CanOperate}" Style="{StaticResource ActionButton}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">
                    <Border Style="{StaticResource PhaseCard}">
                        <StackPanel>
                            <TextBlock Text="1. Calibrate pickup offsets" Style="{StaticResource PhaseTitle}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 1" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadOnePickupResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadOnePickupState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadOnePickupState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadOnePickupState}" Value="Running"><Setter Property="Foreground" Value="#90D3FF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 2" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadTwoPickupResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadTwoPickupState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadTwoPickupState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadTwoPickupState}" Value="Running"><Setter Property="Foreground" Value="#90D3FF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                            
                            
                            <TextBlock Text="{Binding CandidateSummary}" Foreground="#B9C6D6" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PhaseCard}">
                        <StackPanel>
                            <TextBlock Text="2. Verify saved pickup offsets" Style="{StaticResource PhaseTitle}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 1 · disc center" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadOneDiscResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadOneDiscState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadOneDiscState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadOneDiscState}" Value="Running"><Setter Property="Foreground" Value="#90D3FF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 2 · disc center" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadTwoDiscResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadTwoDiscState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadTwoDiscState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadTwoDiscState}" Value="Running"><Setter Property="Foreground" Value="#90D3FF"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                            
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PhaseCard}">
                        <StackPanel>
                            <TextBlock Text="3. Validate shared bottom camera" Style="{StaticResource PhaseTitle}"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 1 · uncorrected nozzle" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadOneCenterProof.ResidualMm, StringFormat='{}{0:F3} mm', FallbackValue='Not tested', TargetNullValue='Not tested'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadOneCenterProof.Verified}" Value="True"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadOneCenterProof.Verified}" Value="False"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Head 2 · uncorrected nozzle" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding HeadTwoCenterProof.ResidualMm, StringFormat='{}{0:F3} mm', FallbackValue='Not tested', TargetNullValue='Not tested'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadTwoCenterProof.Verified}" Value="True"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HeadTwoCenterProof.Verified}" Value="False"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                            
                    

                            <TextBlock Text="{Binding SharedCameraStatus}" Foreground="#B9C6D6" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding RepeatabilityProgress}" Foreground="#90D3FF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,2"/>
                    <TextBlock Text="{Binding FiducialCheckpointStatus}" Foreground="#B9C6D6" FontSize="12" TextWrapping="Wrap" Margin="4,2"/>
                    <Button Content="Run again" Click="RunAgain_Click" IsEnabled="{Binding CanStartAutomatic}" Style="{StaticResource PhaseButton}"/>
                    <CheckBox Content="Full Diagnostics" IsChecked="{Binding FullDiagnostics, Mode=TwoWay}" IsEnabled="{Binding CanOperate}" Foreground="#EDF2F8" FontSize="14" Margin="4,4,0,8"/>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#40546A"/>
            <Border Grid.Column="2" Background="#101721" BorderBrush="#35475A" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TabControl Background="#172333" Foreground="#EDF4FA" SelectedIndex="1">
                    <TabItem Header="Top camera – fixture">
                        <cal:CalibrationVideoSurface FrameSource="{Binding CalibrationMachine.PositionImageCaptureService.CaptureImage}"
                                                     Caption="LIVE TOP CAMERA"/>
                    </TabItem>
                    <TabItem Header="Bottom camera – nozzle / disc">
                        <cal:CalibrationVideoSurface FrameSource="{Binding CalibrationMachine.PartInspectionCaptureService.CaptureImage}"
                                                     Caption="LIVE BOTTOM CAMERA · green = measured acceptance">
                            <cal:CalibrationVideoSurface.Markers>
                                <MultiBinding Converter="{StaticResource SavedPickupMarkers}">
                                    <Binding Path="SavedPickupProof"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.CaptureImage"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.Camera.EffectivePixelsPerMM"/>
                                    <Binding Path="ShowSavedPickupRing"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.Profile.Key"/>
                                    <Binding Path="VisibleNozzleProof"/>
                                </MultiBinding>
                            </cal:CalibrationVideoSurface.Markers>
                        </cal:CalibrationVideoSurface>
                    </TabItem>
                </TabControl>

                    <StackPanel Grid.Row="1" Margin="8,8,8,4">
                        <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding HistoryStatus}" Foreground="#A2C9D7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Supervise all motion; emergency stop is independent. Optical overlays disappear before motion resumes." Foreground="#B9C6D6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Expander Grid.Row="2" Header="Diagnostics, repeatability &amp; run history" IsExpanded="False"
                  Foreground="#EDF2F8" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,4,4,0">
                    <WrapPanel>
                        
                        <TextBlock Text="Iterations/head:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="48" Text="{Binding DiagnosticIterations, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}"/>
                        
                        
                        <Button Content="Preview bottom camera" Click="PreviewBottomCamera_Click" IsEnabled="{Binding CanOperate}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Retry history save" Click="RetryHistory_Click" IsEnabled="{Binding CanRetryHistory}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Copy run report" Click="CopyRunReport_Click" Margin="8,0,0,0" Padding="6,4"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ConfiguredHeights}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SavedPickupStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BottomVisionState}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BottomVisionMeasurements}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HistoryRunId, StringFormat='Run ID: {0}'}"/>
                    <TextBlock Text="{Binding LocalHistoryPath}" TextWrapping="Wrap"/>
                    <cal:CalibrationStepRail Steps="{Binding CalibrationSteps}" Height="130"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>

    </Grid>
</Window>
