<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.CameraToolPickupCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Camera-to-Tool XY Calibration"
        Width="1020" Height="790" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#181D26" Foreground="#EAF0F6"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ProcedureCard" TargetType="Border">
            <Setter Property="Background" Value="#252E3B"/>
            <Setter Property="BorderBrush" Value="#3A4556"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="BorderBrush" Value="#55B7FF"/>
                    <Setter Property="Background" Value="#26394A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="BorderBrush" Value="#3E7961"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="#D55F66"/>
                    <Setter Property="Background" Value="#3B2A32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A4B1C0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#90D3FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#79EDAD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#FF9299"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="#277EC4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F9BD8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#232B38" CornerRadius="10" Padding="18,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CAMERA → TOOL / TWO-PASS PICKUP"
                               FontWeight="Bold" FontSize="11" Foreground="#8FBFE9"/>
                    <TextBlock Text="Pickup Offset Calibration" FontWeight="SemiBold"
                               FontSize="25" Margin="0,5,0,3"/>
                    <TextBlock Text="{Binding ToolHeadName}" Foreground="#DFE9F5"
                               FontSize="14"/>
                    <TextBlock Text="Known Location · 7.5 mm white calibration disc" Foreground="#ACBDD0"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="MEASUREMENT PLAN" Foreground="#91A5BC"
                               HorizontalAlignment="Right" FontSize="10"/>
                    <TextBlock Text="Two pickups · selected head 1 or 2"
                               FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right"/>
                    <TextBlock Text="Top-camera reference · bottom-camera verification"
                               Foreground="#B6C3D2" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" BorderBrush="#375B75" BorderThickness="1" Background="#213341"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="UNSAVED / VERIFIED TOOL OFFSET" FontSize="10"
                           Foreground="#93BAD9" FontWeight="Bold"/>
                <TextBlock Text="{Binding CandidateSummary}" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F1F8FF" Margin="0,3,0,0"/>
                <TextBlock Text="No head offsets are changed until the second independent pickup passes the acceptance threshold." FontSize="12" Foreground="#C9D5E3"
                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="First machine test: leave Auto-save unchecked. The selected head's existing Pick/Place heights and machine Safe Move Z are used automatically. Confirm cylinder clearance/focus on the first supervised run."
                           FontSize="11" Foreground="#B9C6D6" TextWrapping="Wrap"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="4,0,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Head (1/2):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="38" Text="{Binding HeadIndexText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                    <CheckBox Content="Auto-save offset (disabled during initial machine verification)"
                              IsChecked="{Binding SaveVerifiedOffset}" VerticalAlignment="Center"
                              IsEnabled="False"
                              ToolTip="Preserve original offsets until two-pick optical accuracy and hardware clearance are independently proven."/>
                </StackPanel>
                <TextBlock Text="{Binding ConfiguredHeights}" TextWrapping="Wrap"
                           Margin="0,7,0,2" FontWeight="SemiBold"/>
                <TextBlock Text="Pickup/return use the selected head's saved Pick/Place heights. Held-disc inspection completes XY travel at Safe Move Height, then moves common Z to the selected head's configured Pick Height. Verify fixture clearance and optical focus during supervised testing."
                           FontSize="11" Foreground="#B9C6D6" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#1C3039" BorderBrush="#426876"
                    BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="BOTTOM CAMERA / CALIBRATION DISC CENTROID"
                               FontSize="10" Foreground="#A2C9D7" FontWeight="Bold"/>
                    <TextBlock Text="{Binding BottomVisionState}" FontSize="12"
                               Foreground="#E8F1F8" FontWeight="SemiBold" Margin="0,3,0,1"/>
                    <TextBlock Text="{Binding BottomVisionMeasurements}" FontSize="11"
                               FontFamily="Consolas" Foreground="#C5DFE8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="#" Foreground="#AAB8C9"/>
            <TextBlock Grid.Column="1" Text="STAGE / MEASUREMENT" Foreground="#AAB8C9"/>
            <TextBlock Grid.Column="2" Text="STATUS" Foreground="#AAB8C9"/>
            <TextBlock Grid.Column="3" Text="ELAPSED" TextAlignment="Right" Foreground="#AAB8C9"/>
            <TextBlock Grid.Column="4" Text="RETRIES" TextAlignment="Right" Foreground="#AAB8C9"/>
            </Grid>
        </Grid>
        <!-- Shared T008-T013 progress rail and real bottom-camera surface.
             This view has no hardware side effects on opening. -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cal:CalibrationStepRail Grid.Column="0"
                                     Steps="{Binding CalibrationSteps}"
                                     Margin="0,0,12,0"/>
            <Border Grid.Column="1" Background="#0E1720"
                    BorderBrush="#39516B" BorderThickness="1"
                    CornerRadius="8" Padding="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <cal:CalibrationVideoSurface Grid.Row="0"
                        FrameSource="{Binding CalibrationMachine.PartInspectionCaptureService.CaptureImage}"
                        Caption="LIVE BOTTOM CAMERA · observe held calibration target and nozzle"/>
                    <Border Grid.Row="1" Background="#1A2938"
                            BorderBrush="#344A60" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="BOTTOM-CAMERA EVIDENCE"
                                       FontWeight="Bold" Foreground="#91BDDE"
                                       FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding BottomVisionState}"
                                       FontWeight="SemiBold" Foreground="#E9F5FF"
                                       FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BottomVisionMeasurements}"
                                       FontFamily="Consolas" Foreground="#C0D5E5"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="Live camera frames are for observation. Only fresh vision and vacuum-sensor evidence can advance a calibration step."
                                       Foreground="#A8BCCF" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="First physical run must be attended. Emergency stop is independent. Closing the window is blocked while machine motion is active."
                           TextWrapping="Wrap" Foreground="#9DADC1" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Start / Run Again" Style="{StaticResource ActionButton}"
                    Click="RunAgain_Click" />
            <Button Grid.Column="2" Content="Close" Style="{StaticResource ActionButton}"
                    Click="Close_Click" IsEnabled="{Binding CalibrationFinished}"/>
        </Grid>
    </Grid>
</Window>
