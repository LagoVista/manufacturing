<Window x:Class="LagoVista.PickAndPlace.App.Controls.Machine.CameraToolPickupCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine.Calibration"
        Title="Camera-to-Tool XY Calibration"
        Width="1640" Height="1170" MinWidth="950" MinHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="#161C25" Foreground="#EDF2F8"
        Closing="Window_Closing">
    <Window.Resources>
        <cal:CameraToolSavedPickupMarkersConverter x:Key="SavedPickupMarkers"/>
        <Style x:Key="ProcedureCard" TargetType="Border">
            <Setter Property="Background" Value="#252E3B"/>
            <Setter Property="BorderBrush" Value="#3A4556"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="BorderBrush" Value="#55B7FF"/>
                    <Setter Property="Background" Value="#26394A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="BorderBrush" Value="#3E7961"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="#D55F66"/>
                    <Setter Property="Background" Value="#3B2A32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A4B1C0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#90D3FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#79EDAD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#FF9299"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="#277EC4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4F9BD8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PhaseCard" TargetType="Border">
            <Setter Property="Background" Value="#222D3C"/>
            <Setter Property="BorderBrush" Value="#40546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PhaseTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F6FC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B9C6D6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style x:Key="NozzleResult" TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verified}" Value="True">
                    <Setter Property="Foreground" Value="#79EDAD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verified}" Value="False">
                    <Setter Property="Foreground" Value="#FF9299"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhaseButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock Text="Tool head &amp; bottom-camera calibration" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Complete phases 1 and 2 for both heads, then phase 3. Maximum radial error: 0.200 mm."
                           Foreground="#B9C6D6" FontSize="14" Margin="0,4,0,0"/>
                <CheckBox Content="Full Diagnostics" IsChecked="{Binding FullDiagnostics, Mode=TwoWay}" IsEnabled="{Binding CanOperate}" Foreground="#EDF2F8" Margin="0,7,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Close" Style="{StaticResource ActionButton}"
                    Click="Close_Click" IsEnabled="{Binding CanOperate}"/>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource PhaseCard}">
                <StackPanel>
                    <TextBlock Text="1  ·  Calibrate pickup offset" Style="{StaticResource PhaseTitle}"/>
                    <ComboBox Height="32" SelectedValuePath="Tag" SelectedValue="{Binding HeadIndexText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanOperate}">
                        <ComboBoxItem Content="Head 1 – Left" Tag="1"/>
                        <ComboBoxItem Content="Head 2 – Right" Tag="2"/>
                    </ComboBox>
                    <TextBlock Text="{Binding CandidateSummary}" Style="{StaticResource ResultText}"/>
                    <Button Content="Run two-pick calibration" Click="RunAgain_Click" IsEnabled="{Binding CanOperate}" Style="{StaticResource PhaseButton}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PhaseCard}">
                <StackPanel>
                    <TextBlock Text="2  ·  Approve &amp; verify pickup" Style="{StaticResource PhaseTitle}"/>
                    <TextBlock Text="Third pickup using the saved offset. Disc and nozzle measured at the camera." Foreground="#B9C6D6" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HeadOneDiscResult, StringFormat='Head 1: {0}'}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeadOneDiscState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                    <DataTrigger Binding="{Binding HeadOneDiscState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    <TextBlock Text="{Binding HeadTwoDiscResult, StringFormat='Head 2: {0}'}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeadTwoDiscState}" Value="Passed"><Setter Property="Foreground" Value="#79EDAD"/></DataTrigger>
                                    <DataTrigger Binding="{Binding HeadTwoDiscState}" Value="Failed"><Setter Property="Foreground" Value="#FF9299"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    <Button Content="Approve &amp; verify third pickup" Click="SaveAndVerify_Click" IsEnabled="{Binding CanSaveAndVerify}" Style="{StaticResource PhaseButton}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PhaseCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="3  ·  Calibrate bottom camera" Style="{StaticResource PhaseTitle}"/>
                    <TextBlock DataContext="{Binding HeadOneCenterProof}" Style="{StaticResource NozzleResult}"
                            Text="{Binding Summary, FallbackValue='Head 1: not yet validated', TargetNullValue='Head 1: not yet validated'}"/>
                    <TextBlock DataContext="{Binding HeadTwoCenterProof}" Style="{StaticResource NozzleResult}"
                            Text="{Binding Summary, FallbackValue='Head 2: not yet validated', TargetNullValue='Head 2: not yet validated'}"/>
                    <TextBlock Text="Uncorrected nozzle-to-camera error" Foreground="#B9C6D6" FontSize="12"/>
                    <Button Content="Measure shared camera (Head 1)" Click="ProposeCamera_Click" IsEnabled="{Binding CanOperate}" Style="{StaticResource PhaseButton}"/>
                    <Button Content="Approve &amp; validate both nozzles" Click="ApproveCamera_Click">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PhaseButton}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanOperate}" Value="True"/>
                                <Condition Binding="{Binding SharedCandidateReady}" Value="True"/>
                            </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <TextBlock Text="{Binding SharedCameraStatus}" TextWrapping="Wrap" Foreground="#A2C9D7" Margin="0,6,0,0" FontSize="12"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="#101721" BorderBrush="#35475A" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TabControl Background="#172333" Foreground="#EDF4FA" SelectedIndex="1">
                    <TabItem Header="Top camera – fixture">
                        <cal:CalibrationVideoSurface FrameSource="{Binding CalibrationMachine.PositionImageCaptureService.CaptureImage}"
                                                     Caption="LIVE TOP CAMERA"/>
                    </TabItem>
                    <TabItem Header="Bottom camera – nozzle / disc">
                        <cal:CalibrationVideoSurface FrameSource="{Binding CalibrationMachine.PartInspectionCaptureService.CaptureImage}"
                                                     Caption="LIVE BOTTOM CAMERA · green = measured acceptance">
                            <cal:CalibrationVideoSurface.Markers>
                                <MultiBinding Converter="{StaticResource SavedPickupMarkers}">
                                    <Binding Path="SavedPickupProof"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.CaptureImage"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.Camera.EffectivePixelsPerMM"/>
                                    <Binding Path="ShowSavedPickupRing"/>
                                    <Binding Path="CalibrationMachine.PartInspectionCaptureService.Profile.Key"/>
                                    <Binding Path="VisibleNozzleProof"/>
                                </MultiBinding>
                            </cal:CalibrationVideoSurface.Markers>
                        </cal:CalibrationVideoSurface>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="1" Margin="8,8,8,4">
                    <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HistoryStatus}" Foreground="#A2C9D7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Supervise all motion; emergency stop is independent. Optical overlays disappear before motion resumes."
                               Foreground="#B9C6D6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Expander Grid.Row="3" Header="Diagnostics, repeatability &amp; run history" IsExpanded="False"
                  Foreground="#EDF2F8" Margin="0,8,0,0">
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,4,4,0">
                    <WrapPanel>
                        
                        <TextBlock Text="Iterations/head:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="48" Text="{Binding DiagnosticIterations, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOperate}"/>
                        <Button Content="Run extended diagnostics" Click="RunDiagnostics_Click" IsEnabled="{Binding CanOperate}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Validate both again (no correction)" Click="ValidateCamera_Click" IsEnabled="{Binding CanOperate}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Preview bottom camera" Click="PreviewBottomCamera_Click" IsEnabled="{Binding CanOperate}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Retry history save" Click="RetryHistory_Click" IsEnabled="{Binding CanRetryHistory}" Margin="8,0,0,0" Padding="6,4"/>
                        <Button Content="Copy run report" Click="CopyRunReport_Click" Margin="8,0,0,0" Padding="6,4"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ConfiguredHeights}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SavedPickupStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BottomVisionState}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BottomVisionMeasurements}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HistoryRunId, StringFormat='Run ID: {0}'}"/>
                    <TextBlock Text="{Binding LocalHistoryPath}" TextWrapping="Wrap"/>
                    <cal:CalibrationStepRail Steps="{Binding CalibrationSteps}" Height="130"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <Button Grid.Row="0" Content="Stop after safe boundary" Click="StopDiagnostics_Click"
                IsEnabled="{Binding SharedOperationActive}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,120,0" Style="{StaticResource ActionButton}"/>
    </Grid>
</Window>
