<ucb:VMBoundUserControl x:Class="LagoVista.PickAndPlace.App.Controls.Machine.MachineCalibrationControl"
             x:TypeArguments="vm:IMachineCalibrationViewModel"                        
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:mch="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ucb="clr-namespace:LagoVista.XPlat;assembly=LagoVista.XPlat.WPF"
             d:DataContext="{d:DesignInstance vm:IMachineCalibrationViewModel }"
             xmlns:vm="clr-namespace:LagoVista.PickAndPlace.Interfaces.ViewModels.Machine;assembly=LagoVista.PickAndPlace"                                        
             xmlns:local="clr-namespace:LagoVista.PickAndPlace.App.Controls.Machine"
             xmlns:r="clr-namespace:LagoVista.Manufacturing.Models.Resources;assembly=LagoVista.Manufacturing.Models"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1600">
    <!-- Keep each calibration workflow in a dedicated view. Selection state lives in the existing view models. -->
    <!-- Machine is the calibration launchpad. The existing category tabs
         remain for configuration and detailed status; all launch buttons reuse
         their original handlers and never initiate movement on tab selection. -->
    <TabControl x:Name="CalibrationTabs" Margin="6" SelectedIndex="0" Background="Transparent">
        <TabItem Header="Machine">
            <Border Background="#151F2A" Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18" MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Machine Calibration" FontSize="28" FontWeight="Bold"
                               Foreground="#E9F3FD" Margin="0,0,0,6"/>
                    <TextBlock Text="Open a single calibration for troubleshooting, or run the complete supervised sequence below."
                               TextWrapping="Wrap" FontSize="13" Foreground="#AFC7DE"
                               MaxWidth="1020" Margin="0,0,0,17"/>
                    <Border Background="#21364A" BorderBrush="#4B779B"
                            BorderThickness="1" CornerRadius="9"
                            Padding="17" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ONE-CLICK CALIBRATION SEQUENCE"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="#98D4FC" Margin="0,0,0,6"/>
                            <TextBlock Text="Exposure → Machine fiducial → Every staging plate → Installed nozzle runout → Camera-to-tool XY for each installed head"
                                       FontSize="12" Foreground="#E8F3FD"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Excludes vacuum calibration. Physical machine motion begins with this button: supervise the machine and keep the independent emergency stop accessible. Every stage must verify success before the next starts. Camera-to-tool offsets require an explicit operator approval and green third-pickup verification before continuing."
                                       FontSize="11" Foreground="#E8C38D"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="AllCalibrationSequenceButton"
                                    Content="Run All Calibrations (Except Vacuum)"
                                    Click="RunAllCalibrations_Click"
                                    Style="{StaticResource CommandButton}"
                                    HorizontalAlignment="Left" MinWidth="310" Height="44"/>
                            <TextBlock x:Name="AllCalibrationSequenceStatus"
                                       Text="Ready. Individual calibration windows remain available below."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="#B6D1E4" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="2">
                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock Text="01  Camera Exposure" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Calibrate the position camera's black/white fiducial exposure. Saves the verified camera baseline."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,15"/>
                                <Button Content="Open Exposure Calibration"
                                        Click="OpenExposureCalibration_Click"
                                        Style="{StaticResource CommandButton}"
                                        HorizontalAlignment="Left" MinWidth="235" Height="38"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="02  Machine Fiducial" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Locate and center on the machine fiducial, then establish the machine origin from a fresh verified circle."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,15"/>
                                <Button Content="Open Fiducial Calibration"
                                        Click="OpenFiducialCalibration_Click"
                                        Style="{StaticResource CommandButton}"
                                        HorizontalAlignment="Left" MinWidth="235" Height="38"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Origin this session: "
                                               Foreground="#A9BECE" FontSize="11"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Not verified"/>
                                                <Setter Property="Foreground" Value="#D5AA80"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Machine.WasMachinOriginCalibrated}" Value="True">
                                                        <Setter Property="Text" Value="Verified"/>
                                                        <Setter Property="Foreground" Value="#83D8AA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock Text="03  Staging Plates" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Measure two reference holes on a selected plate, verify their physical alignment, and save the plate coordinates."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,9"/>
                                <TextBlock Text="Select one staging plate in the dialog. Requires the machine origin to be verified this session."
                                           Foreground="#D8B67F" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="Open Staging Plate Calibration"
                                            Click="OpenStagingPlateCalibration_Click"
                                            ToolTip="Opens the independent two-hole procedure. No machine movement until Run."
                                            Style="{StaticResource CommandButton}"
                                            MinWidth="235" Height="38"/>
                                    <Button Content="Configure Plates"
                                            Click="OpenStagingPlateSettings_Click"
                                            Style="{StaticResource CommandButton}"
                                            Margin="8,0,0,0" Height="38"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="04  Nozzle Runout" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Measure each installed nozzle's rotational runout and logical zero using the bottom camera."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,15"/>
                                <Button Content="Open Nozzle Calibration"
                                        Click="OpenNozzleRunout_Click"
                                        Style="{StaticResource CommandButton}"
                                        HorizontalAlignment="Left" MinWidth="235" Height="38"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock Text="05  Vacuum and Solenoids" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Run the existing supervised vacuum pump, valve and sensor calibration for both tool heads."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,15"/>
                                <Button Content="Open Vacuum Calibration"
                                        Click="OpenVacuumCalibration_Click"
                                        Style="{StaticResource CommandButton}"
                                        HorizontalAlignment="Left" MinWidth="235" Height="38"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#202E3E" BorderBrush="#39526B"
                                BorderThickness="1" CornerRadius="9"
                                Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="06  Camera Scale and Position" FontSize="18"
                                           FontWeight="SemiBold" Foreground="#F2F7FC"/>
                                <TextBlock Text="Configure camera positions and measure pixels per millimeter. These controls remain in Camera settings."
                                           TextWrapping="Wrap" Foreground="#B6C9DC"
                                           FontSize="12" Margin="0,7,0,15"/>
                                <Button Content="Open Camera Settings"
                                        Click="OpenCameraSettings_Click"
                                        Style="{StaticResource CommandButton}"
                                        HorizontalAlignment="Left" MinWidth="235" Height="38"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="#202E3E" BorderBrush="#39526B" BorderThickness="1"
                            CornerRadius="9" Padding="19" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Camera-to-Tool XY Alignment · T003" FontSize="18"
                                       FontWeight="SemiBold" Foreground="#F2F7FC"/>
                            <TextBlock Text="Guided two-pass pickup. Top-camera white reference, vacuum-confirmed pickup, bottom-camera measurement and independent verification before saving."
                                       TextWrapping="Wrap" Foreground="#B6C9DC"
                                       FontSize="12" Margin="0,7,0,10"/>
                            <TextBlock Text="Requires both installed nozzles, a reliable vacuum channel and clear fixture. Opening starts supervised motion."
                                       Foreground="#D8B67F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <CheckBox x:Name="CameraToolFullDiagnostics" Content="Full Diagnostics (measure, save and validate)" IsChecked="True" Foreground="#EDF2F8" Margin="0,0,0,8"/>
                            <Button Content="Open Camera-to-Tool Calibration"
                                    Click="OpenCameraToolPickup_Click"
                                    Style="{StaticResource CommandButton}"
                                    HorizontalAlignment="Left" MinWidth="245" Height="38"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </TabItem>
        <TabItem Header="Locations">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource label}" Text="Machine Fiducial: "></TextBlock>
                            <TextBlock Style="{StaticResource content}" Text="{Binding MachineConfiguration.MachineFiducial}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetMachineFiducialCommand}"  ToolTip="Set the current location as the Machine Fiducial, this will act as a know point to reference all other points on the machine." Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/SetTarget.png"/>
                                </Button.Content>
                            </Button>
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToMachineFiducialCommand}"  ToolTip="Goto the Machine Fiducial" Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/MoveToTarget.png"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource label}" Text="Known Location: "></TextBlock>
                            <TextBlock Style="{StaticResource content}" Text="{Binding MachineConfiguration.KnownCalibrationPoint}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" MaxWidth="320">
                            <StackPanel Orientation="Horizontal">
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding CaptureKnownLocationCommand}"  ToolTip="Set the known reference location." Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/SetTarget.png"/>
                                </Button.Content>
                            </Button>
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToKnownLocationCommand}"  ToolTip="Goto the known reference location" Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/MoveToTarget.png"/>
                                </Button.Content>
                            </Button>
                            </StackPanel>
                            <Button Content="Verify / Center Calibration Cylinder"
                                    Command="{Binding VerifyKnownLocationCylinderCommand}"
                                    ToolTip="Locate the 7 mm cylinder at Known Location with the existing profile. Perform a bounded top-camera XY jog only when needed; no pickup or settings changes."
                                    Width="278" Height="36" HorizontalAlignment="Left"
                                    Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding CylinderCenterStatus}"
                                       Margin="0,5,6,0" TextWrapping="Wrap"
                                       FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource label}" Text="Default Work Origin: "></TextBlock>
                            <TextBlock Style="{StaticResource content}" Text="{Binding MachineConfiguration.DefaultWorkOrigin}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetDefaultPCBOrigin}"  ToolTip="Set the default work home location, this is typically where the PCB is." Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/SetTarget.png"/>
                                </Button.Content>
                            </Button>
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToDefaultPCBOrigin}"  ToolTip="Goto the default work location" Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/MoveToTarget.png"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="3" Grid.Row="0">
                            <TextBlock Style="{StaticResource label}" Text="Default Safe Move Height: "></TextBlock>
                            <TextBlock Style="{StaticResource content}" Text="{Binding MachineConfiguration.DefaultSafeMoveHeight}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetDefaultSafeMoveHeightCommand}"  ToolTip="Capture the current value of the Z axis as the safe move height.." Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/SetTarget.png"/>
                                </Button.Content>
                            </Button>
                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToDefaultSafeMoveHeightCommand}"  ToolTip="Move the Z axis to safe move height." Width="64" Height="64"  >
                                <Button.Content>
                                    <Image Source="/imgs/MoveToTarget.png"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="StagingPlatesTab" Header="Staging Plates">
            <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding  MachineConfiguration.StagingPlates}" SelectedItem="{Binding SelectedStagingPlate}" AutoGenerateColumns="false" CanUserAddRows="false">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                                <DataGridTemplateColumn Header="Calibrated" Width="95" IsReadOnly="true">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="✓" Foreground="LimeGreen" FontSize="22" TextAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="true" Header="Hole Spacing" Binding="{Binding HoleSpacing}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Size" Binding="{Binding Size}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 1 Row" Binding="{Binding ReferenceHoleRow1}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 1 Col" Binding="{Binding ReferenceHoleColumn1}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 1 XY" Binding="{Binding ReferenceHoleLocation1}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 2 Row" Binding="{Binding ReferenceHoleRow2}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 2 Col" Binding="{Binding ReferenceHoleColumn2}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Hole 2 XY" Binding="{Binding ReferenceHoleLocation2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Column="1" Margin="20,0,0,0" Visibility="{Binding SelectedStagingPlate, Converter={StaticResource NoTNullToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource header}"  Text="{Binding SelectedStagingPlate.Name}"></TextBlock>
                                <StackPanel Grid.Column="0" Grid.Row="1" >
                                    <StackPanel>
                                    <TextBlock Style="{StaticResource header}">Reference Hole 1</TextBlock>
                                    <TextBlock   Style="{StaticResource content}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{} Col: {0} Row: {1}">
                                                    <Binding Path="SelectedStagingPlate.ReferenceHoleColumn1.Text" />
                                                    <Binding Path="SelectedStagingPlate.ReferenceHoleRow1.Text" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
            
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedStagingPlate.ReferenceHoleLocation1}" Style="{StaticResource content}"></TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetStagingPlateReferenceHole1LocationCommand}"  ToolTip="Set Reference Hole 1" Width="64" Height="64"  >
                                                <Button.Content>
                                                    <Image Source="/imgs/SetTarget.png"/>
                                                </Button.Content>
                                            </Button>
                                            <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToStagingPlateReferenceHole1LocationCommand}"  ToolTip="Move To Reference Hole 1" Width="64" Height="64"  >
                                                <Button.Content>
                                                    <Image Source="/imgs/MoveToTarget.png"/>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
            
                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Style="{StaticResource header}">Reference Hole 2</TextBlock>
                                    <TextBlock   Style="{StaticResource content}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{} Col: {0} Row: {1}">
                                                <Binding Path="SelectedStagingPlate.ReferenceHoleColumn2.Text" />
                                                <Binding Path="SelectedStagingPlate.ReferenceHoleRow2.Text" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                <TextBlock Text="{Binding SelectedStagingPlate.ReferenceHoleLocation2}" Style="{StaticResource content}"></TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetStagingPlateReferenceHole2LocationCommand}"  ToolTip="Set Reference Hole 2" Width="64" Height="64"  >
                                            <Button.Content>
                                                <Image Source="/imgs/SetTarget.png"/>
                                            </Button.Content>
                                        </Button>
                                        <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToStagingPlateReferenceHole2LocationCommand}"  ToolTip="Move To Reference Hole 2" Width="64" Height="64"  >
                                            <Button.Content>
                                                <Image Source="/imgs/MoveToTarget.png"/>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
            
                        </Grid>
            
                    </Grid>
        </TabItem>
        <TabItem Header="Feeder Rails">
            <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding  MachineConfiguration.FeederRails}" CanUserAddRows="false" AutoGenerateColumns="false" SelectedItem="{Binding SelectedFeederRail}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Slot Count" Binding="{Binding NumberSlots}" />
                                <DataGridTextColumn Header="First Slot Index" Binding="{Binding SlotStartIndex}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Rotation" Binding="{Binding Rotation}" />
                                <DataGridTextColumn IsReadOnly="true" Header="First Feeder Origin" Binding="{Binding FirstFeederOrigin}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="1" Visibility="{Binding SelectedFeederRail, Converter={StaticResource NoTNullToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource header}" Text="{Binding SelectedFeederRail.Name}"></TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource content}" >Move the position camera to the left edge of the first feeder on the rail, and have it centered on the rail as closely as possible.</TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetFirstAutoFeederOriginCommand}"  ToolTip="Set the origin of the first feeder on the rail." Width="64" Height="64"  >
                                    <Button.Content>
                                        <Image Source="/imgs/SetTarget.png"/>
                                    </Button.Content>
                                </Button>
                                <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToFirstAutoFeederOriginCommand}"  ToolTip="Set the origin of the first feeder on the rail." Width="64" Height="64"  >
                                    <Button.Content>
                                        <Image Source="/imgs/MoveToTarget.png"/>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
        </TabItem>
        <TabItem Header="Tool Heads">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <local:ToolHeadControl />
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="CamerasTab" Header="Cameras">
            <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding  MachineConfiguration.Cameras}"  AutoGenerateColumns="False" CanUserAddRows="false" SelectedItem="{Binding SelectedMachineCamera}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Width="140" Binding="{Binding Name}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Camera Type" Width="115" Binding="{Binding CameraType}" />
                                <DataGridTextColumn IsReadOnly="true" Width="180" Header="Device Id" Binding="{Binding CameraDevice.Text}" />
                                <DataGridTextColumn IsReadOnly="true" Header="Location" Width="150" Binding="{Binding AbsolutePosition}" />
                                <DataGridTextColumn Header="Pixels per MM" Width="125" Binding="{Binding PixelsPerMM}" />
                                <DataGridTextColumn Header="Focus Height" Width="115" Binding="{Binding FocusHeight}" />
                                <DataGridTextColumn Header="Exposure" Width="100" Binding="{Binding Exposure}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0,0,0">
                          <StackPanel Visibility="{Binding SelectedMachineCamera, Converter={StaticResource NoTNullToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource header}" Text="{Binding SelectedMachineCamera.Name}"></TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource content}" >This is only done with the camera that is fixed.  Move the position camera over the bottom camera, center the position camera lens over the bottom camera and capture the point.</TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource content}" Text="{Binding SelectedMachineCamera.AbsolutePosition}" />
                                    <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding SetCameraLocationCommand}"  ToolTip="Set the camera location." Width="64" Height="64"  >
                                    <Button.Content>
                                        <Image Source="/imgs/SetTarget.png"/>
                                    </Button.Content>
                                </Button>
                                </StackPanel>
                                <Button BorderBrush="Transparent"  Background="Transparent" Command="{Binding MoveToCameraLocationCommand}"  ToolTip="Move to the camera location." Width="64" Height="64"  >
                                    <Button.Content>
                                        <Image Source="/imgs/MoveToTarget.png"/>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource content}"
                                       Text="Machine Fiducial: Auto-Tune moves the position camera to the black/white machine fiducial, waits for motion to complete, normalizes exposure, and persists the camera baseline." />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource content}" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock.Text>
                                        <Binding Path="SelectedMachineCamera.Exposure" StringFormat="Exposure: {0:F1}" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <Button Style="{StaticResource CommandButton}"
                                        Click="OpenExposureCalibration_Click"
                                        Content="Open Exposure Calibration" />
                            </StackPanel>
                            <Button Style="{StaticResource CommandButton}"
                                    Click="OpenFiducialCalibration_Click"
                                    Content="Open Machine Fiducial Calibration"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
            
                            <Separator Margin="0,12,0,10"/>
                            <TextBlock Style="{StaticResource header}" Text="Camera Pixels per MM"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <TextBlock Text="Camera default: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedMachineCamera.PixelsPerMM, StringFormat='{}{0:F1} px/mm'}"/>
                            </StackPanel>
                            <TextBlock Text="1) Show the 200px square in the selected camera's active vision profile"
                                       TextWrapping="Wrap"/>
                            <CheckBox IsChecked="{Binding SelectedMachineCamera.CurrentVisionProfile.Show200PixelSquare, Mode=TwoWay}"
                                      Content="Show 200px calibration square" Margin="0,4,0,8"/>
                            <TextBlock Text="2) Place a metric ruler at the intended camera calibration height"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="3) Enter the millimeters spanned by the 200px square"
                                       Margin="0,8,0,2"/>
                            <TextBox Text="{Binding CameraMeasuredMM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding ClearAllVisionProfilePixelOverrides, Mode=TwoWay}"
                                      Margin="0,4,0,8">
                                <TextBlock Text="Clear calibration overrides for all vision profiles on this camera"
                                           TextWrapping="Wrap"/>
                            </CheckBox>
                            <Button Style="{StaticResource CommandButton}"
                                    Command="{Binding SetCameraPixelsPerMMCommand}"
                                    Content="Calculate and Save Camera Calibration" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CameraCalibrationStatus}" TextWrapping="Wrap"
                                       Margin="0,8,0,8"/>
                          </StackPanel>
                        </ScrollViewer>
            
                    </Grid>
        </TabItem>
        <TabItem Header="Vacuum">
            <StackPanel Margin="20" VerticalAlignment="Top">
                <TextBlock Text="{x:Static r:ManufacturingResources.VacuumCalibration_Title}"
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="{x:Static r:ManufacturingResources.VacuumCalibration_Intro}"
                           TextWrapping="Wrap" MaxWidth="900" Margin="0,0,0,12"/>
                <Button Content="{x:Static r:ManufacturingResources.VacuumCalibration_Title}"
                        Click="OpenVacuumCalibration_Click"
                        Style="{StaticResource CommandButton}" Height="44"
                        Width="320" HorizontalAlignment="Left"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Nozzles">
            <Grid Margin="16" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Installed tool-head runout calibration"
                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="Each head is calibrated for its currently installed nozzle. All heads begin uncalibrated after machine startup, reconnect or homing. A nozzle change requires recalibration."
                               TextWrapping="Wrap" Margin="0,0,0,10" MaxWidth="900"
                               HorizontalAlignment="Left"/>
                    <Button Content="Calibrate Installed Tool Heads"
                            Click="OpenNozzleRunout_Click"
                            Style="{StaticResource CommandButton}"
                            HorizontalAlignment="Left" Width="280" Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Tool-head calibration status"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="The procedure discovers every installed nozzle from the tool-head assignments and runs a separate 30-degree optical sweep for each. Camera/tool XY calibration remains separate."
                               TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- MachineConfiguration.ToolHeads are the physical
                     installations; MachineConfiguration.Nozzles are rack
                     assignments and are not the runout calibration owner. -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding MachineConfiguration.ToolHeads}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True"
                          Height="Auto" MaxHeight="240" MinHeight="96"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          MinWidth="780" MaxWidth="1040"
                          RowHeight="36" ColumnHeaderHeight="34"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Margin="0,4,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Head" Width="70" Binding="{Binding HeadIndex}"/>
                        <DataGridTextColumn Header="Tool head" Width="170" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Installed nozzle" Width="185"
                            Binding="{Binding CurrentNozzle.Text, TargetNullValue='None installed', FallbackValue='None installed'}"/>
                        <DataGridTemplateColumn Header="Runout status" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Needs calibration"/>
                                                <Setter Property="Foreground" Value="#C57A35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                        <Setter Property="Text" Value="Calibrated this session"/>
                                                        <Setter Property="Foreground" Value="#16845A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="High-Y zero (degrees)" Width="160"
                            Binding="{Binding RunoutZeroAngle, StringFormat={}{0:F0}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Camera / Tool XY">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Automated Camera-to-Tool XY Calibration"
                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="The 7 mm white cylinder in its black holder uses the existing Known Location and Known Location circle profile. Each installed nozzle makes two independent pickups. Bottom-camera measurements propose and verify a static head XY correction."
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="For the first supervised run, the selected head uses its configured Pick Height and Place Height, with common Safe Move Z for held-cylinder inspection. No manual Z entry is needed. Verify clearance and focus; offset saving remains disabled until hardware accuracy is established."
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Button Content="Calibrate Camera-to-Tool XY"
                            Click="OpenCameraToolPickup_Click"
                            HorizontalAlignment="Left" Width="286" Height="44"
                            Style="{StaticResource CommandButton}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</ucb:VMBoundUserControl>
