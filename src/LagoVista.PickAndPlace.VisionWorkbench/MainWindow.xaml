<Window x:Class="LagoVista.PickAndPlace.VisionWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick &amp; Place — Vision Workbench" Height="820" Width="1290"
        MinHeight="620" MinWidth="900" Background="#171C24" Foreground="#E8EDF5"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#32435E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#546785"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="Vision Workbench"/>
            <TextBlock Foreground="#A8B5C6" Margin="0,4,0,14"
                       Text="Open or drop an image. Compare original pixels with grayscale and threshold processing."/>
            <WrapPanel Margin="0,0,0,14">
                <Button Content="Open image..." Click="OpenImage_Click"/>
                <Button Content="Save processed..." Click="SaveProcessed_Click"/>
                <Button Content="Fit view" Click="FitView_Click"/>
                <CheckBox Content="Invert threshold" VerticalAlignment="Center" Margin="16,0,12,0"
                          IsChecked="{Binding InvertThreshold, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <Slider x:Name="ThresholdSlider" Width="190" Minimum="0" Maximum="255"
                        Value="128" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="Threshold_Changed" VerticalAlignment="Center"/>
                <TextBlock x:Name="ThresholdLabel" Text="128" Width="34" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#344154" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready — open an image or drag one into this window."
                       Foreground="#B8C6D7" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6"
                    Background="#0D1118">
                <DockPanel>
                    <TextBlock Text="ORIGINAL" FontWeight="SemiBold" Foreground="#B4C7DA"
                               Margin="12" DockPanel.Dock="Top"/>
                    <ScrollViewer x:Name="OriginalScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Image x:Name="OriginalImage" Stretch="Uniform"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6"
                    Background="#0D1118">
                <DockPanel>
                    <TextBlock Text="PROCESSED — GRAYSCALE / THRESHOLD" FontWeight="SemiBold"
                               Foreground="#B4C7DA" Margin="12" DockPanel.Dock="Top"/>
                    <ScrollViewer x:Name="ProcessedScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ProcessedImage" Stretch="Uniform"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="3" Margin="14,0,0,0" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6" Background="#202937">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="VISION PROFILE" Foreground="#B4C7DA" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="New" Click="NewProfile_Click"/>
                        <Button Content="Open..." Click="OpenProfile_Click"/>
                        <Button Content="Save" Click="SaveProfile_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Profile name" Margin="0,4,0,3"/>
                            <TextBox x:Name="ProfileName" TextChanged="ProfileText_Changed"/>
                            <TextBlock Text="Profile key" Margin="0,10,0,3"/>
                            <TextBox x:Name="ProfileKey" TextChanged="ProfileText_Changed"/>
                            <TextBlock Text="PREPROCESSING" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8"/>
                            <CheckBox x:Name="ApplyThresholdCheck" Content="Apply threshold" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="InvertCheck" Content="Invert" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="ApplyMaskCheck" Content="Apply mask" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="BlurCheck" Content="Use blurred image" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <TextBlock Text="Primary threshold (profile 0–100)" Margin="0,8,0,2"/>
                            <Slider x:Name="PrimaryThresholdSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ProfileSlider_Changed"/>
                            <TextBlock x:Name="PrimaryThresholdValue" Margin="0,0,0,6"/>
                            <TextBlock Text="Gaussian kernel size" Margin="0,4,0,2"/>
                            <Slider x:Name="KernelSlider" Minimum="1" Maximum="19" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="ProfileSlider_Changed"/>
                            <TextBlock x:Name="KernelValue" Margin="0,0,0,6"/>
                            <TextBlock Text="DETECTION" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,15,0,8"/>
                            <CheckBox x:Name="FindCirclesCheck" Content="Find circles" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="FindRectanglesCheck" Content="Find rectangles" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="FindLinesCheck" Content="Find lines" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="FindCornersCheck" Content="Find corners" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <CheckBox x:Name="CannyCheck" Content="Use Canny edge detection" Margin="0,0,0,8" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <TextBlock Text="Canny low threshold" Margin="0,8,0,2"/>
                            <Slider x:Name="CannySlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ProfileSlider_Changed"/>
                            <TextBlock x:Name="CannyValue"/>
                            <TextBlock Text="CAMERA / LIGHTING (saved only; offline)" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="Exposure" Margin="0,5,0,2"/>
                            <TextBox x:Name="ExposureBox" LostFocus="CameraValue_LostFocus"/>
                            <TextBlock Text="Brightness" Margin="0,8,0,2"/>
                            <TextBox x:Name="BrightnessBox" LostFocus="CameraValue_LostFocus"/>
                            <TextBlock Text="Contrast" Margin="0,8,0,2"/>
                            <TextBox x:Name="ContrastBox" LostFocus="CameraValue_LostFocus"/>
                            <CheckBox x:Name="LightOnCheck" Content="Light on" Margin="0,12,0,6" Checked="ProfileSetting_Changed" Unchecked="ProfileSetting_Changed"/>
                            <TextBlock x:Name="ProfileStatus" Text="Local profile (unsaved)" Foreground="#A8B5C6" TextWrapping="Wrap" Margin="0,15,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
