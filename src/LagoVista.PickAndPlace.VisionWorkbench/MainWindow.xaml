<Window x:Class="LagoVista.PickAndPlace.VisionWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick &amp; Place — Vision Workbench" Height="820" Width="1290"
        MinHeight="620" MinWidth="900" Background="#171C24" Foreground="#E8EDF5"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#32435E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#546785"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="#546785"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="Vision Workbench"/>
            <TextBlock Foreground="#A8B5C6" Margin="0,4,0,14"
                       Text="Open or drop an image. Compare original pixels with grayscale and threshold processing."/>
            <WrapPanel Margin="0,0,0,14">
                <Button Content="Open image..." Click="OpenImage_Click"/>
                <ComboBox Width="250" Margin="0,0,8,0" ItemsSource="{Binding RecentImages}" DisplayMemberPath="DisplayName" SelectionChanged="RecentImage_SelectionChanged" ToolTip="Recently opened images" Background="#263449" Foreground="White"/>
                <Button Content="Save processed..." Click="SaveProcessed_Click"/>
                <Button Content="Fit view" Click="FitView_Click"/>
                <CheckBox Content="Invert threshold" VerticalAlignment="Center" Margin="16,0,12,0" IsChecked="{Binding Profile.Invert, Mode=TwoWay}"/>
                <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <Slider Width="190" Minimum="0" Maximum="255" Value="{Binding ThresholdValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ThresholdValue, StringFormat=F0}" Width="34" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#344154" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}"
                       Foreground="#B8C6D7" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6"
                    Background="#0D1118">
                <DockPanel>
                    <TextBlock Text="ORIGINAL" FontWeight="SemiBold" Foreground="#B4C7DA"
                               Margin="12" DockPanel.Dock="Top"/>
                    <ScrollViewer x:Name="OriginalScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding OriginalImage}" Stretch="Uniform"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6"
                    Background="#0D1118">
                <DockPanel>
                    <TextBlock Text="PROCESSED — GRAYSCALE / THRESHOLD" FontWeight="SemiBold"
                               Foreground="#B4C7DA" Margin="12" DockPanel.Dock="Top"/>
                    <ScrollViewer x:Name="ProcessedScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid><Image Source="{Binding ProcessedImage}" Stretch="Uniform"/><Image Source="{Binding DetectionOverlay}" Stretch="Uniform" IsHitTestVisible="False"/></Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="3" Margin="14,0,0,0" BorderBrush="#43516A" BorderThickness="1" CornerRadius="6" Background="#202937">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="VISION PROFILE" Foreground="#B4C7DA" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="New" Click="NewProfile_Click"/>
                        <Button Content="Open..." Click="OpenProfile_Click"/>
                        <Button Content="Save" Click="SaveProfile_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Profile name" Margin="0,4,0,3"/>
                            <TextBox Text="{Binding Profile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Profile key" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding Profile.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="PREPROCESSING" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8"/>
                            <CheckBox Content="Apply threshold" Margin="0,0,0,8" IsChecked="{Binding Profile.ApplyThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Invert" Margin="0,0,0,8" IsChecked="{Binding Profile.Invert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Apply mask" Margin="0,0,0,8" IsChecked="{Binding Profile.ApplyMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Use blurred image" Margin="0,0,0,8" IsChecked="{Binding Profile.UseBlurredImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Primary threshold (profile 0–100)" Margin="0,8,0,2"/>
                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Profile.PrimaryThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding ThresholdText}" Margin="0,0,0,6"/>
                            <TextBlock Text="Gaussian kernel size" Margin="0,4,0,2"/>
                            <Slider Minimum="1" Maximum="19" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding Profile.GausianKernellSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding KernelText}" Margin="0,0,0,6"/>
                            <TextBlock Text="DETECTION" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,15,0,8"/>
                            <CheckBox Content="Find circles" Margin="0,0,0,8" IsChecked="{Binding Profile.FindCircles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Find rectangles" Margin="0,0,0,8" IsChecked="{Binding Profile.FindRectangles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Find lines" Margin="0,0,0,8" IsChecked="{Binding Profile.FindLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Find corners" Margin="0,0,0,8" IsChecked="{Binding Profile.FindCorners, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Use Canny edge detection" Margin="0,0,0,8" IsChecked="{Binding Profile.UseCannyEdgeDetection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Canny low threshold" Margin="0,8,0,2"/>
                            <Slider Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Profile.CannyLowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding CannyText}"/>
                            <TextBlock Text="CIRCLE DETECTION (HOUGH)" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8"/>
                            <TextBlock Text="Pixels per mm (calibration)" Margin="0,4,0,3"/>
                            <TextBox Text="{Binding Profile.PixelsPerMM, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Minimum radius (mm)" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding Profile.HoughCirclesMinRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Maximum radius (mm)" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding Profile.HoughCirclesMaxRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Minimum center spacing (mm)" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding Profile.HoughCirclesMinDistance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Hough DP (inverse resolution ratio)" Margin="0,10,0,3"/>
                            <TextBox Text="{Binding Profile.HoughCirclesDP, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Hough Param1 (edge threshold)" Margin="0,10,0,3"/>
                            <Slider Minimum="1" Maximum="300" TickFrequency="1" Value="{Binding Profile.HoughCirclesParam1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding Profile.HoughCirclesParam1, StringFormat=F0}" Margin="0,0,0,5"/>
                            <TextBlock Text="Hough Param2 (vote threshold)" Margin="0,10,0,3"/>
                            <Slider Minimum="1" Maximum="600" TickFrequency="1" Value="{Binding Profile.HoughCirclesParam2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding Profile.HoughCirclesParam2, StringFormat=F0}" Margin="0,0,0,5"/>
                            <TextBlock Text="DETECTED CIRCLES (image pixels)" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8"/>
                            <TextBlock Text="{Binding CircleSummary}" Foreground="#B8C6D7" Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding CircleMeasurements}" MaxHeight="180" Background="#101722" Foreground="#E8EDF5" BorderBrush="#546785" />
                            <TextBlock Text="TAPE GEOMETRY (READ ONLY)" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8"/>
                            <TextBlock Text="Nominal consecutive hole pitch (mm)" Margin="0,4,0,3"/>
                            <TextBox Text="{Binding TapeHolePitchMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="{Binding TapeGeometrySummary}" Foreground="#B8C6D7" TextWrapping="Wrap" Margin="0,10,0,6"/>
                            <TextBlock Text="Assumes detected holes are consecutive and ordered along the tape. Verify before using calibration." FontSize="11" Foreground="#E6B56C" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBlock Text="CAMERA / LIGHTING (saved only; offline)" Foreground="#9DB5D9" FontWeight="Bold" Margin="0,20,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="Exposure" Margin="0,5,0,2"/>
                            <TextBox Text="{Binding Profile.Exposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Brightness" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding Profile.Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Contrast" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding Profile.Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="Light on" Margin="0,12,0,6" IsChecked="{Binding Profile.LightOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding ProfileStatus}" Foreground="#A8B5C6" TextWrapping="Wrap" Margin="0,15,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
