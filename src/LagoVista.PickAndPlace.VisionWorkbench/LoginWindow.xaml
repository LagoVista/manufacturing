<Window x:Class="LagoVista.PickAndPlace.VisionWorkbench.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to NuvIoT" Height="260" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171C24" Foreground="#E8EDF5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Platform Sign In" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Email" Margin="0,0,0,4"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="2" Height="30" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="30"/>
            <TextBlock x:Name="StatusText" Foreground="#F4A6A6" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="LoginButton" Width="90" Content="Sign in" Click="Login_Click"/>
        </StackPanel>
    </Grid>
</Window>
